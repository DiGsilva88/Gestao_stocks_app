<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="Login"
        android:textColor="@color/text_primary"
        android:textSize="28sp" />

    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Utilizador"
        android:inputType="text"
        android:background="@drawable/bg_campo"
        android:minHeight="48dp"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Password"
        android:background="@drawable/bg_campo"
        android:minHeight="48dp"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:inputType="textPassword"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="28dp"
        android:text="Entrar →"
        android:contentDescription="Entrar"
        android:backgroundTint="@color/accent"
        android:textColor="@color/contrast" />

    <!-- Button em vez de TextView: dá o papel de botão ao leitor de ecrã
         e a altura mínima de 48dp para o toque -->
    <Button
        android:id="@+id/txtIrRegisto"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="18dp"
        android:text="Ainda não tenho conta" />

</LinearLayout>