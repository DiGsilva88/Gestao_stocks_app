<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icone"
                android:contentDescription="@string/desc_abrir_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/pagina_stock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stock_titulo"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnOrdenar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icone"
                android:padding="12dp"
                android:src="@drawable/ic_ordenar"
                android:contentDescription="@string/stock_ordenar"
                app:tint="@color/accent" />

        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card"
            app:tabIndicatorColor="@color/accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/accent"
            app:tabTextColor="@color/text_muted">

            <!-- TabItems são vistas virtuais: não podem ter id (o ViewBinding
                 procurava-as em runtime e rebentava porque já não existem) -->
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/produtos" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alertas" />

        </com.google.android.material.tabs.TabLayout>

        <!-- Conteúdo do separador Produtos -->
        <LinearLayout
            android:id="@+id/conteudoProdutos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/editPesquisa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/stock_pesquisar"
                android:background="@drawable/bg_campo"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:inputType="text"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="horizontal"
                android:scrollbarThumbHorizontal="@color/text_muted">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodos"
                        style="@style/ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_todos"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        style="@style/ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_motores" />

                    <com.google.android.material.chip.Chip
                        style="@style/ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_sensores" />

                    <com.google.android.material.chip.Chip
                        style="@style/ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_cabos" />

                    <com.google.android.material.chip.Chip
                        style="@style/ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_filtros" />

                    <com.google.android.material.chip.Chip
                        style="@style/ChipFiltro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_valvulas" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProdutos"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                tools:listitem="@layout/item_produto" />

            <TextView
                android:id="@+id/txtVazio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/stock_vazio"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Conteúdo do separador Alertas -->
        <LinearLayout
            android:id="@+id/conteudoAlertas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtContadorAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/aviso"
                android:textSize="13sp"
                tools:text="3 itens" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAlertas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                tools:listitem="@layout/item_alerta" />

            <TextView
                android:id="@+id/txtVazioAlertas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/sem_alertas"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdicionar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/stock_adicionar"
        app:backgroundTint="@color/accent"
        app:tint="@color/contrast" />

</FrameLayout>