<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/inicioFragment">

    <fragment
        android:id="@+id/inicioFragment"
        android:name="com.example.gesto_stocks.ui.inicio.InicioFragment"
        android:label="Início"
        tools:layout="@layout/fragment_inicio" />

    <fragment
        android:id="@+id/stockFragment"
        android:name="com.example.gesto_stocks.ui.stocks.StockFragment"
        android:label="Stock"
        tools:layout="@layout/fragment_stock">

        <action
            android:id="@+id/acaoStockParaForm"
            app:destination="@id/produtoFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/produtoFormFragment"
        android:name="com.example.gesto_stocks.ui.stocks.ProdutoFormFragment"
        android:label="Produto"
        tools:layout="@layout/fragment_produto_form">

        <argument
            android:name="produtoId"
            app:argType="integer"
            android:defaultValue="-1" />

    </fragment>

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.gesto_stocks.ui.perfil.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil">

        <action
            android:id="@+id/acaoPerfilParaEditar"
            app:destination="@id/editarPerfilFragment" />

    </fragment>

    <fragment
        android:id="@+id/editarPerfilFragment"
        android:name="com.example.gesto_stocks.ui.perfil.EditarPerfilFragment"
        android:label="Editar Perfil"
        tools:layout="@layout/fragment_editar_perfil" />

</navigation>