<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Gestão_stocks" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <item name="colorPrimary">@color/accent</item>
    <item name="colorOnPrimary">@color/contrast</item>
    <item name="android:colorBackground">@color/background</item>
    <item name="colorSurface">@color/card</item>
    <item name="android:statusBarColor">@color/background</item>
    <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ChipFiltro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/text_muted</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconTint">@color/accent</item>
        <item name="chipSurfaceColor">@color/card</item>
    </style>

    <style name="MenuPopup" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="IndicadorNav"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent</item>
    </style>
    <style name="RotuloCampo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="CampoTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="RotuloCampoStyle" parent="RotuloCampo" />

    <style name="Theme.Gestão_stocks" parent="Base.Theme.Gestão_stocks" />
</resources>